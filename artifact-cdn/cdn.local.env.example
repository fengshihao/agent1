# 复制为同目录 cdn.local.env（已 gitignore）。不要把 SSH 私钥或生产域名写进仓库。
# 运行时全局入口：AGENT1_CDN_BASE_URL / AGENT1_CDN_HOST（./agent1 会自动 source 本文件）。

AGENT1_CDN_BASE_URL=https://cdn.example.test/
ARTIFACT_CDN_BASE_URL=https://cdn.example.test/

# 站点机器与网站根。上传走本机已有的 SSH 密钥，不开放公网写入口。
ARTIFACT_CDN_SSH=user@your-cdn-host
ARTIFACT_CDN_REMOTE_DIR=/var/www/agentone
