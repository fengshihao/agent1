# 复制为同目录 cdn.local.env（已 gitignore）。不要把 AccessKey 写进这个文件或仓库。
# ossutil 密钥用本机 `ossutil config`，或 ossutil 自己识别的环境变量。

# 与 pack --base-url 相同：CDN 上该前缀的公网根，末尾斜杠可有可无。
ARTIFACT_CDN_BASE_URL=https://cdn.example.com/agent1/

OSS_BUCKET=your-bucket
# 对象键前缀，对应上面的公网根。不要以 / 开头，不要含 ..
OSS_PREFIX=agent1

# 可选。
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSSUTIL_CONFIG=/absolute/path/to/ossutilconfig
