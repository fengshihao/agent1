#!/usr/bin/env bash
# 生成本地 Release 签名：release.keystore + release-signing.properties
# 密码可通过环境变量覆盖：RELEASE_STORE_PASSWORD、RELEASE_KEY_PASSWORD

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
KEYSTORE="$ROOT_DIR/release.keystore"
PROPS="$ROOT_DIR/release-signing.properties"

STORE_PASS="${RELEASE_STORE_PASSWORD:-agent1release}"
KEY_PASS="${RELEASE_KEY_PASSWORD:-$STORE_PASS}"
ALIAS="${RELEASE_KEY_ALIAS:-agent1-release}"

if [[ -f "$KEYSTORE" ]]; then
  echo "已存在: $KEYSTORE（跳过 keytool；若要重建请先删除该文件）"
else
  echo "==> 生成 Release keystore: $KEYSTORE"
  keytool -genkeypair -v \
    -keystore "$KEYSTORE" \
    -alias "$ALIAS" \
    -keyalg RSA -keysize 2048 -validity 10000 \
    -storepass "$STORE_PASS" \
    -keypass "$KEY_PASS" \
    -dname "CN=Agent1 Android Release, OU=Mobile, O=Agent1, L=Local, ST=Local, C=CN"
fi

if [[ -f "$PROPS" ]]; then
  echo "已存在: $PROPS（跳过写入）"
else
  cat >"$PROPS" <<EOF
storeFile=release.keystore
keyAlias=$ALIAS
storePassword=$STORE_PASS
keyPassword=$KEY_PASS
EOF
  echo "==> 已写入 $PROPS（勿提交 git）"
fi

echo "==> Release 签名就绪。assembleRelease 将自动使用该配置。"
