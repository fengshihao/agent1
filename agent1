#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# 生产力助手命令行入口（仓库根目录）
#
# 用法：
#   ./agent1                  # 交互 REPL
#   ./agent1 你好             # 单次提问
#   ./agent1 models           # 查看当前运行时与 Qwen 主模型规格
#   ./agent1 logs failed      # 查 events.jsonl
#   ./agent1 logs summarize --session <id>
#
# 默认走 fat-jar（./run-java-agent）。想跳过打包、直接用 Gradle classpath：
#   AGENT1_USE_GRADLE=1 ./agent1 models
# 已有 jar、跳过增量构建：
#   JAVA_AGENT_SKIP_BUILD=1 ./agent1 你好
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
agent1 — 生产力助手 CLI

  ./agent1                         交互模式
  ./agent1 <问题>                  单次提问后退出
  ./agent1 models                  当前模型与 Qwen 主规格
  ./agent1 logs failed             失败工具调用
  ./agent1 logs children --parent-run <id>
  ./agent1 logs summarize --session <id>

环境变量：
  QWEN_API_KEY / DASHSCOPE_API_KEY   模型密钥
  QWEN_MODEL / OPENAI_MODEL          模型名（默认 qwen3.7-flash）
  AGENT1_AGENT_ROOT                  数据目录（默认 ./.agent1）
  AGENT1_USE_GRADLE=1                用 Gradle 跑，不打 fat-jar
  JAVA_AGENT_SKIP_BUILD=1            跳过 fat-jar 增量构建

经典（非生产力）CLI 仍用：./run-java-agent …
EOF
  exit 0
fi

if [[ "${AGENT1_USE_GRADLE:-0}" == "1" ]]; then
  exec "${SCRIPT_DIR}/run-java-agent-gradle" --productivity "$@"
fi

exec "${SCRIPT_DIR}/run-java-agent" --productivity "$@"
